# Backend origin used by the Next.js /api rewrite (and by SSR). The browser calls
# same-origin /api/* so PATCH settings work even if Spring CORS omits PATCH.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Optional override for the rewrite target only:
# API_PROXY_TARGET=http://localhost:8080

# Admin username used by the public portfolio (POST /api/public/{userName}).
# This is the adminUser value, not the login email.
NEXT_PUBLIC_PORTFOLIO_USERNAME=

# Name shown in the copyright footer.
NEXT_PUBLIC_SITE_NAME=Manoj's Dossier

# Accent every visitor sees by default:
# forest, ocean, midnight, or vermilion.
NEXT_PUBLIC_DEFAULT_ACCENT=midnight
